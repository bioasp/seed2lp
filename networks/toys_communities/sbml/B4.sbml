      <reaction id="R_R11" name="R_R11" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_Q_c" stoichiometry="1" constant="true"/>
