      <species id="M_S_e" name="S" compartment="e" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_T_e" name="T" compartment="e" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_U_e" name="U" compartment="e" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_E_e" name="E" compartment="e" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_BM4_e" name="BM4" compartment="e" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_Q_c" name="Q" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_R_c" name="R" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_S_c" name="S" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_T_c" name="T" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_U_c" name="U" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_E_c" name="E" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="M_P_c" name="P" compartment="c" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter sboTerm="SBO:0000624" id="cobra_default_lb" value="-1000" constant="true"/>
      <parameter sboTerm="SBO:0000624" id="cobra_min_10" value="-10" constant="true"/>
      <parameter sboTerm="SBO:0000624" id="cobra_default_ub" value="1000" constant="true"/>
      <parameter sboTerm="SBO:0000624" id="cobra_0_bound" value="0" constant="true"/>
      <parameter sboTerm="SBO:0000624" id="minus_inf" value="-INF" constant="true"/>
      <parameter sboTerm="SBO:0000624" id="plus_inf" value="INF" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="R_EX_Q" name="R_EX_Q" reversible="true" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_Q_e" stoichiometry="1.0000" constant="true"/>
        </listOfReactants>
