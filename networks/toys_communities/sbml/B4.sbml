      <reaction id="R_R" name="R_R" reversible="false" fast="false" fbc:lowerFluxBound="cobra_default_lb" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_R_e" stoichiometry="1" constant="true"/>
        </listOfReactants>
