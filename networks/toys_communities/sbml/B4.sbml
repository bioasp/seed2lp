      <reaction id="R_R12" name="R_R12" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_U_c" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
