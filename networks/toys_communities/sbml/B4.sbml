      <reaction id="R_Biom4" name="R_Biom4" reversible="false" fast="false" fbc:lowerFluxBound="cobra_0_bound" fbc:upperFluxBound="cobra_default_ub">
        <listOfReactants>
          <speciesReference species="M_P_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_S_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_T_c" stoichiometry="1" constant="true"/>
          <speciesReference species="M_U_c" stoichiometry="1" constant="true"/>
